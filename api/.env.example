# =============================================================================
# VizioBox API - modele de configuration
# Copier en .env (local) ou saisir dans les variables Railway (production).
# Ne JAMAIS mettre de vraie valeur secrete dans ce fichier : il est versionne.
# Les valeurs indiquees sont les valeurs par defaut ou des exemples.
# =============================================================================

# --- Application ------------------------------------------------------------
# Railway ne le definit pas : obligatoire en production (sinon mode debogage).
NODE_ENV=development
# Railway : garder 3000 (le domaine public pointe sur ce port).
PORT=3000
APP_NAME=VizioBox API
APP_BASE_URL=http://localhost:3000
# URL publique de l'app client (liens envoyes aux clients).
CLIENT_APP_BASE_URL=
SWAGGER_ENABLED=true
# true uniquement en developpement (synchronise le schema automatiquement).
SEQUELIZE_SYNC=false
SENTRY_DSN=

# --- Base de donnees ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matontine_mvp
DB_USER=root
DB_PASSWORD=
# Bases hebergees (Aiven, etc.) : DB_SSL=true et DB_SSL_REJECT_UNAUTHORIZED=true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Securite / authentification ----------------------------------------------
# Obligatoire en production : chaine aleatoire longue (48 octets en base64).
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
# Obligatoire en production : mot de passe fort.
ADMIN_PASSWORD=
ADMIN_JWT_EXPIRES_IN=12h
# Montant (FCFA) au-dela duquel une deuxieme validation est exigee.
MAKER_CHECKER_THRESHOLD=500000
ENABLE_DEVICE_APPROVAL=false
DEVICE_APPROVAL_TTL_SECONDS=120

# --- OTP ------------------------------------------------------------------------
ENABLE_OTP=true
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_BLOCK_MINUTES=15

# --- Agent par defaut (developpement uniquement) ----------------------------------
AGENT_DEFAULT_CODE=AGT-001
AGENT_DEFAULT_NAME=Agent Demo
AGENT_DEFAULT_PHONE=
AGENT_DEFAULT_PIN=
AGENT_DEFAULT_BALANCE=0

# --- Informations legales et support (recus, mentions) ----------------------------
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# --- WhatsApp -------------------------------------------------------------------
# meta (API Cloud officielle) ou web (whatsapp-web.js + Chrome).
WHATSAPP_PROVIDER=meta
ENABLE_WHATSAPP_OTP=true
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=v21.0
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=fr
# Fournisseur "web" seulement.
WHATSAPP_WEB_VERSION=
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=

# --- Notifications push (Firebase) ------------------------------------------------
# Contenu JSON complet du compte de service, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT=
# Alternative au JSON complet :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=

# --- FedaPay (Mobile Money MTN / Moov / Celtiis) ------------------------------------
# sandbox ou live (la cle doit correspondre a l'environnement).
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_API_BASE_URL=
FEDAPAY_PUSH_MODES=
FEDAPAY_PUSH_PHONE_COUNTRY=bj
FEDAPAY_PUSH_MAX_PER_WINDOW=5
FEDAPAY_PUSH_WINDOW_MINUTES=10
FEDAPAY_PUSH_MIN_INTERVAL_SECONDS=30
# Delai avant d'expirer une transaction inconnue de FedaPay (erreur 404).
FEDAPAY_NOT_FOUND_GRACE_HOURS=48
# Reconciliation automatique (ms, defaut 6 h).
RECONCILIATION_CRON_INTERVAL_MS=21600000

# --- MTN MoMo (integration directe) --------------------------------------------------
MTN_MOMO_ENV=sandbox
MTN_MOMO_API_BASE_URL=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_MSISDN_COUNTRY_CODE=
MTN_MOMO_CALLBACK_BASE_URL=

# --- AfrikMoney -----------------------------------------------------------------------
AFRIKMONEY_API_BASE_URL=https://pay.afrikmoney.com
AFRIKMONEY_API_KEY=
AFRIKMONEY_WEBHOOK_SECRET=
AFRIKMONEY_CUSTOMER_EMAIL_DOMAIN=example.com

# --- Community Manager (assistant IA) ----------------------------------------------------
# Cle gratuite : https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=
# gemini ou anthropic. Vide : Gemini si GEMINI_API_KEY est defini, sinon Claude.
COMMUNITY_AI_PROVIDER=
# Vide : gemini-3.8-flash (Gemini) ou claude-opus-5-5 (Claude).
COMMUNITY_AI_MODEL=
# Claude seulement (cle payante sur platform.claude.com).
ANTHROPIC_API_KEY=
COMMUNITY_AI_EFFORT=medium
